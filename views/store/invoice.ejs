<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nota Fiscal - <%= store.name %></title>
  <link rel="stylesheet" href="/css/store.css">
</head>
<body>
  <nav class="navbar" style="background-color: <%= store.theme_color %>;">
    <div class="container">
      <a href="/" class="logo"><%= store.name %></a>
      <ul class="nav-links">
        <li><a href="/">Produtos</a></li>
        <li><a href="/cart">Carrinho</a></li>
        <li><a href="/validate">Validar NF</a></li>
      </ul>
    </div>
  </nav>
  
  <div class="container">
    <div class="invoice-success">
      <h1>✓ Compra Realizada com Sucesso!</h1>
      <p>Sua nota fiscal foi gerada.</p>
    </div>
    
    <div class="invoice-container">
      <div class="invoice-header">
        <h2>NOTA FISCAL</h2>
        <p class="invoice-code"><%= invoice.invoice_code %></p>
      </div>
      
      <div class="invoice-section">
        <h3>Loja</h3>
        <p><%= store.name %></p>
      </div>
      
      <div class="invoice-section">
        <h3>Cliente</h3>
        <p><strong>Nome:</strong> <%= invoice.customer_name %></p>
        <p><strong>Email:</strong> <%= invoice.customer_email %></p>
        <% if (invoice.customer_phone) { %>
          <p><strong>Telefone:</strong> <%= invoice.customer_phone %></p>
        <% } %>
        <% if (invoice.customer_address) { %>
          <p><strong>Endereço:</strong> <%= invoice.customer_address %></p>
        <% } %>
      </div>
      
      <div class="invoice-section">
        <h3>Itens</h3>
        <table class="invoice-table">
          <thead>
            <tr>
              <th>Produto</th>
              <th>Preço Unit.</th>
              <th>Qtd.</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
              <tr>
                <td><%= item.product_name %></td>
                <td>R$ <%= parseFloat(item.product_price).toFixed(2) %></td>
                <td><%= item.quantity %></td>
                <td>R$ <%= (parseFloat(item.product_price) * item.quantity).toFixed(2) %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      
      <div class="invoice-total">
        <h3>Total: R$ <%= parseFloat(invoice.total_amount).toFixed(2) %></h3>
      </div>
      
      <div class="invoice-validation">
        <h3>Código de Validação</h3>
        <p class="validation-code"><%= invoice.validation_code %></p>
        <p class="validation-info">Use este código para validar esta nota fiscal em /validate</p>
      </div>
      
      <div class="invoice-date">
        <p>Emitida em: <%= new Date(invoice.created_at).toLocaleString('pt-BR') %></p>
      </div>
      
      <div class="invoice-actions">
        <button onclick="window.print()" class="btn btn-secondary">Imprimir</button>
        <a href="/" class="btn btn-primary">Voltar à Loja</a>
      </div>
    </div>
  </div>
</body>
</html>
